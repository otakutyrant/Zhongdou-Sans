# Small projects keep their complete command catalog at the stable root
# entrypoint; split this into task modules only if the catalog grows.

const PROJECT_ROOT = path self | path dirname
const BUILD_SCRIPT = $PROJECT_ROOT | path join tools build_font.py
const RELEASE_CHECK_SCRIPT = $PROJECT_ROOT | path join tools check_release.py
const PUNCTUATION_CHECK_SCRIPT = $PROJECT_ROOT | path join tools check_punctuation.py
const BUILD_SITE_SCRIPT = $PROJECT_ROOT | path join tools build_site.py
const SITE_LAYOUT_CHECK_SCRIPT = $PROJECT_ROOT | path join tools check-site-layout.nu
const RENDER_DEMO_SCRIPT = $PROJECT_ROOT | path join tools render-demo.nu
const RENDER_TITLE_SCRIPT = $PROJECT_ROOT | path join tools render-title.nu
const SOURCE_FONT = $PROJECT_ROOT | path join fonts variable ZhudouSansVF.ttf
const BUILT_FONT = $PROJECT_ROOT | path join build ZhongdouSansVF.ttf
const DEMO_PAGE = $PROJECT_ROOT | path join demo index.html

def markdown-files [] {
    ^git ls-files --cached --others --exclude-standard -- '*.md'
    | lines
    | where {|path| ($path | path exists) }
    | sort
    | uniq
}

use tasks/panoptor.nu *

# Build the derivative variable font consumed by every specimen and web task.
export def "nur font build" [] {
    mkdir ($PROJECT_ROOT | path join build)
    ^python $BUILD_SCRIPT $SOURCE_FONT $BUILT_FONT
}

# Preserve the original public task name for existing documentation and habits.
export def "nur demo build" [] {
    nur font build
}

# Build the font and open the compact README specimen in Chromium.
export def "nur demo preview" [] {
    nur font build
    ^chromium $"file://($DEMO_PAGE)"
}

# Regenerate every image committed under images/.
export def "nur specimens render" [] {
    ^nu $RENDER_DEMO_SCRIPT
}

# Preserve the original public rendering task as an alias.
export def "nur demo render" [] {
    nur specimens render
}

# Rebuild only the README's light and dark title specimens.
export def "nur title render" [] {
    nur font build
    ^nu $RENDER_TITLE_SCRIPT
}

# Render to build/ and compare bytes so verification never edits tracked files.
export def "nur specimens check" [] {
    let output_dir = $PROJECT_ROOT | path join build specimens
    if ($output_dir | path exists) {
        rm -r $output_dir
    }
    ^nu $RENDER_DEMO_SCRIPT --output-dir $output_dir

    for name in [demo.png Title.light.svg Title.dark.svg] {
        let expected = $PROJECT_ROOT | path join images $name
        let actual = $output_dir | path join $name
        if (open --raw $expected) != (open --raw $actual) {
            error make {
                msg: $"Generated specimen is stale: images/($name). Run `nur specimens render`."
            }
        }
    }

    print "Committed specimens match a clean render."
}

# Check every encoded punctuation mark at all variable-font extremes and
# render focused horizontal and vertical specimens for visual review.
export def "nur punctuation check" [] {
    nur font build
    let render_dir = $PROJECT_ROOT | path join build assessment punctuation
    ^python $PUNCTUATION_CHECK_SCRIPT $BUILT_FONT --render-dir $render_dir
}

# Build the public site and reduce both webfonts to the characters it uses.
export def "nur site build" [] {
    if ($env.SARASA_REGULAR_TTC? | is-empty) {
        error make {
            msg: "SARASA_REGULAR_TTC is unset. Enter the project with `nix develop`."
        }
    }

    ^python $BUILD_SITE_SCRIPT --project-root $PROJECT_ROOT --sarasa-ttc $env.SARASA_REGULAR_TTC
}

# Exercise actual Chromium layout and all interactive playground controls.
export def "nur site check" [] {
    nur site build
    ^nu $SITE_LAYOUT_CHECK_SCRIPT
}

# Preserve the more specific historic task name as an alias.
export def "nur site check-layout" [] {
    nur site check
}

# Build and serve the GitHub Pages site locally.
export def "nur site preview" [--port: int = 8000] {
    nur site build
    ^python -m http.server $port --directory ($PROJECT_ROOT | path join build site)
}

# Run Ruff's import, correctness, modernization, and style diagnostics.
export def "nur python ruff" [] {
    ^ruff check tools tests
}

# Run the independent Python diagnostics that complement Ruff.
export def "nur python pylint" [] {
    ^pylint tools tests
}

# Check strict static types, including test code.
export def "nur python typecheck" [] {
    ^basedpyright
}

# Run focused unit tests and one built-font integration fixture.
export def "nur python test" [] {
    ^pytest
}

# Format maintained Python sources and tests.
export def "nur python format" [] {
    ^ruff format tools tests
}

# Verify Python formatting without changing files.
export def "nur python format-check" [] {
    ^ruff format --check tools tests
}

# Run Python diagnostics and tests before the non-mutating format check.
export def "nur python check" [] {
    nur python ruff
    nur python pylint
    nur python typecheck
    nur python test
    nur python format-check
}

# Format maintained Markdown files with the shared Prettier configuration.
export def "nur markdown format" [] {
    let files = (markdown-files)
    if ($files | is-not-empty) {
        ^prettier --write ...$files
    }
}

# Verify Markdown formatting without changing files.
export def "nur markdown format-check" [] {
    let files = (markdown-files)
    if ($files | is-not-empty) {
        ^prettier --check ...$files
    }
}

# Diagnose JavaScript and CSS while leaving authored HTML alone.
export def "nur web lint" [] {
    ^biome lint site demo
}

# Format only the JavaScript and CSS selected in biome.json.
export def "nur web format" [] {
    ^biome format --write site demo
}

# Verify JavaScript and CSS formatting without changing files.
export def "nur web format-check" [] {
    ^biome format site demo
}

# Run framework-free JavaScript and CSS diagnostics and formatting checks.
export def "nur web check" [] {
    nur web lint
    nur web format-check
}

# Parse and lint the task catalog and all Nushell automation.
export def "nur nu check" [] {
    ^nur --help | ignore
    ^nu-lint --config .nu-lint.toml --format compact nurfile tasks tools
}

# Check the flake's evaluation without rebuilding all derivations.
export def "nur nix check" [] {
    ^nix flake check --no-build
}

# Apply the flake's official nixfmt-tree formatter.
export def "nur nix format" [] {
    ^treefmt
}

# Verify Nix formatting without changing files.
export def "nur nix format-check" [] {
    ^treefmt --ci
}

# Validate flake evaluation and checked-in Nix formatting.
export def "nur nix validate" [] {
    nur nix check
    nur nix format-check
}

# Build the distributable package without creating a result symlink.
export def "nur package build" [] {
    ^nix build --no-link
}

# Keep the watch loop quick enough for continuous local feedback.
export def "nur check fast" [] {
    nur nu check
    nur markdown format-check
    nur python check
    nur web check
    nur nix validate
}

# Run every repository-owned check, including render and package verification.
export def "nur check" [] {
    nur check fast
    nur punctuation check
    nur site check
    nur package build
    nur specimens check
}

# Build the distributable font and ensure its metadata matches the release tag.
export def "nur release build" [tag: string] {
    nur check
    ^python $RELEASE_CHECK_SCRIPT $tag $BUILT_FONT
}

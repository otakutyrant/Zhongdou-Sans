featurePrefixes = (
{
code = "languagesystem DFLT dflt;
languagesystem latn dflt; # Latin default
languagesystem latn JAN;  # Latin Japanese
languagesystem latn KOR;  # Latin Korean
languagesystem latn ZHH;  # Latin Chinese, Traditional, Hong Kong SAR
languagesystem latn ZHS;  # Latin Chinese, Simplified
languagesystem latn ZHT;  # Latin Chinese, Traditional
languagesystem hang dflt; # Hangul default
languagesystem hang JAN;  # Hangul Japanese
languagesystem hang KOR;  # Hangul Korean
languagesystem hang ZHH;  # Hangul Chinese, Traditional, Hong Kong SAR
languagesystem hang ZHS;  # Hangul Chinese, Simplified
languagesystem hang ZHT;  # Hangul Chinese, Traditional
languagesystem hani dflt; # CJK Ideographic default
languagesystem hani JAN;  # CJK Ideographic Japanese
languagesystem hani KOR;  # CJK Ideographic Korean
languagesystem hani ZHH;  # CJK Ideographic Chinese, Traditional, Hong Kong SAR
languagesystem hani ZHS;  # CJK Ideographic Chinese, Simplified
languagesystem hani ZHT;  # CJK Ideographic Chinese, Traditional
languagesystem kana dflt; # Hiragana default
languagesystem kana JAN;  # Hiragana Japanese
languagesystem kana KOR;  # Hiragana Korean
languagesystem kana ZHH;  # Hiragana Chinese, Traditional, Hong Kong SAR
languagesystem kana ZHS;  # Hiragana Chinese, Simplified
languagesystem kana ZHT;  # Hiragana Chinese, Traditional";
name = Languagesystems;
},
{
code = "lookup CN2JP {
sub quoteleft by quoteleft.pwid;
sub quoteright by quoteright.pwid;
sub quotedblleft by quotedblleft.pwid;
sub quotedblright by quotedblright.pwid;
sub exclam.full by exclam.full.uv002;
sub colon.full by colon.full.uv002;
sub semicolon.full by semicolon.full.uv002;
sub question.full by question.full.uv002;
} CN2JP;

lookup CN2TW {
sub periodcentered by periodcentered.full;
sub comma-han by comma-han.uv002;
sub period-han by period-han.uv002;
sub exclam.full by exclam.full.uv002;
sub comma.full by comma.full.uv002;
sub period.full by period.full.uv002;
sub colon.full by colon.full.uv002;
sub semicolon.full by semicolon.full.uv002;
sub question.full by question.full.uv002;
} CN2TW;

lookup vert_CN {
sub comma-han by comma-han.uv002;
sub period-han by period-han.uv002;
sub exclam.full by exclam.full.uv002;
sub comma.full by comma.full.uv002;
sub period.full by period.full.uv002;
sub colon.full by colon.full.uv002;
sub semicolon.full by semicolon.full.uv002;
sub question.full by question.full.uv002;
sub quoteleft by cornerbracketleft.vert;
sub quoteright by cornerbracketright.vert;
sub quotedblleft by whitecornerbracketleft.vert;
sub quotedblright by whitecornerbracketright.vert;
} vert_CN;

lookup vert_JP {
sub colon.full.uv002 by colon.full.vert.loclJAN;
} vert_JP;

lookup vert_KR {
sub exclam.full.uv002 by exclam.vert;
sub colon.full.uv002 by colon.vert;
sub semicolon.full.uv002 by semicolon.vert;
sub question.full.uv002 by question.vert;
} vert_KR;

lookup vert_TW {
sub quoteleft by quoteleft.vert;
sub quoteright by quoteright.vert;
sub quotedblleft by quotedoubleprimeReversed.vert;
sub quotedblright by quotedoubleprime.vert;
} vert_TW;
";
name = GlobalLookup;
notes = "全局查找";
}
);
features = (
{
code = "script DFLT;
language dflt;
lookup CN2TW;

script latn; # Latin
language dflt;
lookup CN2TW;
language JAN exclude_dflt; # Japanese
lookup CN2JP;
language KOR exclude_dflt; # Korean
lookup CN2JP;
language ZHH exclude_dflt; # Chinese, Traditional, Hong Kong SAR
lookup CN2TW;
language ZHS exclude_dflt; # Chinese, Simplified; intentionally use Taiwan punctuation
lookup CN2TW;
language ZHT exclude_dflt; # Chinese, Traditional
lookup CN2TW;

script hang; # Hangul
language dflt;
lookup CN2TW;
language JAN exclude_dflt; # Japanese
lookup CN2JP;
language KOR exclude_dflt; # Korean
lookup CN2JP;
language ZHH exclude_dflt; # Chinese, Traditional, Hong Kong SAR
lookup CN2TW;
language ZHS exclude_dflt; # Chinese, Simplified; intentionally use Taiwan punctuation
lookup CN2TW;
language ZHT exclude_dflt; # Chinese, Traditional
lookup CN2TW;

script hani; # CJK Ideographic
language dflt;
lookup CN2TW;
language JAN exclude_dflt; # Japanese
lookup CN2JP;
language KOR exclude_dflt; # Korean
lookup CN2JP;
language ZHH exclude_dflt; # Chinese, Traditional, Hong Kong SAR
lookup CN2TW;
language ZHS exclude_dflt; # Chinese, Simplified; intentionally use Taiwan punctuation
lookup CN2TW;
language ZHT exclude_dflt; # Chinese, Traditional
lookup CN2TW;

script kana; # Hiragana

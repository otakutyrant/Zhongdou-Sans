lookup CN2TW;
language JAN exclude_dflt; # Japanese
lookup CN2JP;
language KOR exclude_dflt; # Korean
lookup CN2JP;
language ZHH exclude_dflt; # Chinese, Traditional, Hong Kong SAR
lookup CN2TW;
language ZHS exclude_dflt; # Chinese, Simplified; intentionally use Taiwan punctuation
lookup CN2TW;
language ZHT exclude_dflt; # Chinese, Traditional
lookup CN2TW;";
tag = locl;
},
{

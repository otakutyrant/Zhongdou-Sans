# Small projects keep their complete command catalog at the stable root
# entrypoint; split this into task modules only if the catalog grows.

const PROJECT_ROOT = path self | path dirname
const BUILD_SCRIPT = $PROJECT_ROOT | path join tools build_font.py
const RELEASE_CHECK_SCRIPT = $PROJECT_ROOT | path join tools check_release.py
const PUNCTUATION_CHECK_SCRIPT = $PROJECT_ROOT | path join tools check_punctuation.py
const BUILD_SITE_SCRIPT = $PROJECT_ROOT | path join tools build_site.py
const SITE_LAYOUT_CHECK_SCRIPT = $PROJECT_ROOT | path join tools check-site-layout.nu
const SOURCE_FONT = $PROJECT_ROOT | path join fonts variable ZhudouSansVF.ttf
const BUILT_FONT = $PROJECT_ROOT | path join build ZhongdouSansVF.ttf
const DEMO_PAGE = $PROJECT_ROOT | path join demo index.html

# Build the derivative variable font consumed by the HTML specimen.
export def "nur demo build" [] {
    mkdir ($PROJECT_ROOT | path join build)
    ^python $BUILD_SCRIPT $SOURCE_FONT $BUILT_FONT
}

# Build the distributable font and ensure its metadata matches the release tag.
export def "nur release build" [tag: string] {
    # A release must pass the complete punctuation geometry and shaping audit.
    nur punctuation check
    # Chromium catches CSS grid regressions that font geometry cannot detect.
    nur site check-layout
    ^python $RELEASE_CHECK_SCRIPT $tag $BUILT_FONT
}

# Build the font and open the editable specimen in Chromium.
export def "nur demo preview" [] {
    nur demo build
    ^chromium $"file://($DEMO_PAGE)"
}

# Regenerate the PNG embedded at the top of the README.
export def "nur demo render" [] {
    ^nu ($PROJECT_ROOT | path join tools render-demo.nu)
}

# Check every encoded punctuation mark at all variable-font extremes and
# render focused horizontal and vertical specimens for visual review.
export def "nur punctuation check" [] {
    nur demo build
    let render_dir = $PROJECT_ROOT | path join build assessment punctuation
    ^python $PUNCTUATION_CHECK_SCRIPT $BUILT_FONT --render-dir $render_dir
}

# Rebuild the README's light and dark title specimens from the current font.
export def "nur title render" [] {
    nur demo build
    ^nu ($PROJECT_ROOT | path join tools render-title.nu)
}

# Build the public site and reduce both webfonts to the characters it uses.
export def "nur site build" [] {
    if ($env.SARASA_REGULAR_TTC? | is-empty) {
        error make {
            msg: "SARASA_REGULAR_TTC is unset. Enter the project with `nix develop`."
        }
    }

    ^python $BUILD_SITE_SCRIPT --project-root $PROJECT_ROOT --sarasa-ttc $env.SARASA_REGULAR_TTC
}

# Ask Chromium to calculate the actual punctuation-grid tracks and fail when
# any mark's layout box no longer shares the center of its painted cell.
export def "nur site check-layout" [] {
    nur site build
    ^nu $SITE_LAYOUT_CHECK_SCRIPT
}

# Build and serve the GitHub Pages site locally.
export def "nur site preview" [--port: int = 8000] {
    nur site build
    ^python -m http.server $port --directory ($PROJECT_ROOT | path join build site)
}
